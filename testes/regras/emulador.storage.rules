// Só para o emulador LIGAR. O firebase-tools recusa um arquivo de regras fora
// da pasta do projeto ("../../storage.rules is outside of project
// directory"), então o firebase.json desta pasta aponta para cá.
// As regras DE VERDADE são carregadas por cada teste, direto de
// ../../storage.rules (initializeTestEnvironment).
rules_version = "2";
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} { allow read, write: if false; }
  }
}
