// Só para o emulador LIGAR. O firebase-tools recusa um arquivo de regras fora
// da pasta do projeto ("../../firestore.rules is outside of project
// directory"), então o firebase.json desta pasta aponta para cá.
// As regras DE VERDADE são carregadas por cada teste, direto de
// ../../firestore.rules (initializeTestEnvironment).
rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
