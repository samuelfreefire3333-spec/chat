# ===========================================================================
# Backend Go do Sinex Chat — variáveis de ambiente
# ===========================================================================
# Copie para .env SÓ na sua máquina (o .gitignore já ignora .env). No Render,
# cadastre cada variável em Environment. Nunca faça commit de valores reais.
#
# O front-end (Netlify) não usa variáveis de ambiente: a configuração pública
# do Firebase fica em firebase.js e NÃO é segredo — quem protege os dados são
# as regras do Firestore/Storage e as restrições da chave de API no Google
# Cloud (ver SEGURANCA.md, "Configuração de produção").

# production (padrão) ou development. Em development o servidor aceita as
# origens http://localhost:* da lista fixa em config.go e não exige HTTPS.
APP_ENV=production

# Porta HTTP (o Render define sozinho).
PORT=8080

# Projeto Firebase.
FIREBASE_PROJECT_ID=chat-parameuamor

# Conteúdo do JSON da service account (uma linha só). SEGREDO.
#   - Só é aceito JSON do tipo "service_account".
#   - Alternativa: deixar vazio e usar GOOGLE_APPLICATION_CREDENTIALS (caminho
#     de um arquivo FORA do repositório) ou as credenciais padrão do Google.
#   - Papéis mínimos: "Firebase Authentication Admin" e "Cloud Datastore
#     User" (e "Storage Object Admin" só para cmd/migrar-seguranca).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Origens extras do front-end, separadas por vírgula (as de produção já estão
# em config.go). Formato: https://host[:porta], sem barra no fim. "*" e
# "null" são recusados.
ALLOWED_ORIGINS=

# Confia em CF-Connecting-IP / X-Forwarded-For para descobrir o IP do cliente
# (limites por IP). true atrás do Render. Padrão: true em produção.
TRUST_PROXY_HEADERS=true

# Recusa conexões que o proxy informa terem chegado sem TLS. Recomendado: true
# no Render.
REQUIRE_HTTPS=true

# Espera antes de avisar "saiu" quando o WebSocket cai (ms, 0–60000).
PRESENCE_GRACE_MS=6000

# Tetos de conexões simultâneas (proteção contra esgotamento de recursos).
MAX_CONNECTIONS=5000
MAX_CONNECTIONS_PER_IP=30
MAX_CONNECTIONS_PER_USER=10
